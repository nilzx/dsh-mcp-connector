{
  "name": "@nilzx/dsh-mcp-connector",
  "version": "0.1.4",
  "description": "Connect MCP servers to DeepSeek Harness: stdio, Streamable HTTP, SSE, OAuth sign-in, per-tool permissions, and workspace scoping, all managed from a Settings panel.",
  "type": "module",
  "license": "MIT",
  "author": "nilzx",
  "homepage": "https://github.com/nilzx/dsh-mcp-connector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilzx/dsh-mcp-connector.git"
  },
  "bugs": {
    "url": "https://github.com/nilzx/dsh-mcp-connector/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "oauth",
    "deepseek-harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "packageManager": "pnpm@12.21.0"
}
